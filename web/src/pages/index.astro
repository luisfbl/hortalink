---
import BaseLayout from "@layouts/BaseLayout.astro";
import Session from "../stores/Session";

const session = Session.get();

let HomeComponent;
if (session?.profile.is_seller) {
    HomeComponent = (await import("@components/pages/home/SellerHome.astro")).default;
} else if (session) {
    HomeComponent = (await import("@components/pages/home/CustomerHome.astro")).default;
} else {
    HomeComponent = (await import("@components/pages/home/Unsigned.astro")).default;
}

export const prerender = false;
---

<BaseLayout>
    <Fragment slot="head">
        <title>Hortalink</title>
    </Fragment>
    <Fragment slot="body">
        <HomeComponent />

        {!session &&
            <script define:vars={{ session }}>
                const navbar = document.querySelector(".navbar_container")
                navbar.hidden = true
                </script>
        }
    </Fragment>
</BaseLayout>