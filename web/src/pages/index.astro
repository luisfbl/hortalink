---
import "@styles/pages/home/unsigned.scss";

import BaseLayout from "@layouts/BaseLayout.astro";

import Unsigned from "@components/pages/home/Unsigned.astro";
import CustomerHome from "@components/pages/home/CustomerHome.astro";
import Session from "../stores/Session";
import SellerHome from "../components/pages/home/SellerHome.astro";

const session = Session.get()
export const prerender = false
---

<BaseLayout>
    <Fragment slot="head">
        <title>Hortalink</title>
    </Fragment>
    <Fragment slot="body">
        { session && (session.profile.is_seller ? <SellerHome/> : <CustomerHome />) }
        { !session && <Unsigned /> }

        { !session &&
            <script define:vars={{ session }}>
                const navbar = document.querySelector(".navbar_container")
                navbar.hidden = true
            </script>
        }
    </Fragment>
</BaseLayout>