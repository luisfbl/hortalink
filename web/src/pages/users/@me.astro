---
import "@styles/pages/users/@me.scss";

import BaseLayout from "@layouts/BaseLayout.astro";
import ProfileCard from "@components/pages/users/@me/ProfileCard";

import Selector from "../../components/pages/users/Selector";
import UserRatingsSection from "@components/pages/users/@me/sections/Ratings";

import SellerRatingsSection from "../../components/pages/users/seller/sections/RatingsSection";
import APIWrapper, {RequestAPIFrom} from "../../API/Wrapper";
import OrdersSection from "../../components/pages/users/@me/sections/OrdersSection";

const api = new APIWrapper(RequestAPIFrom.Server)
const session_cookie = Astro.cookies.get("session_id")
const session_id = session_cookie?.value || null
const user = await api.getCurrentSession(session_id, true)
---

<BaseLayout>
    <Fragment slot="head">
        <title>Hortalink | Meu perfil</title>
    </Fragment>
    <Fragment slot="body">
        <header>
            <div class="background">
                <a href="/users/@me/settings" class="settings_button">
                    <img src="/assets/settings.svg" alt="Abrir configurações"/>
                </a>
            </div>
            <ProfileCard profile = {user.profile} client:load />
        </header>
        <main>
            <Selector is_seller={user?.profile?.is_seller || false} me_info={true} client:load />
            {
                user.profile.is_seller ?
                    <>
                        <SellerRatingsSection ratings={user.reviews} client:load />
                    </> :
                    <>
                        <OrdersSection orders={user.orders} client:load />
                        <UserRatingsSection client:load />
                    </>
            }
        </main>
    </Fragment>
</BaseLayout>