---
import "@styles/global.scss";

import APIWrapper, {RequestAPIFrom} from "../API/Wrapper";
import Session from "../stores/Session";

interface Props {
    no_nav?: boolean
}

const nonav = Astro.props?.no_nav

const session_cookie = Astro.cookies.get("session_id")
const session_id = session_cookie?.value || null
const wrapper = new APIWrapper(RequestAPIFrom.Server)

let user = null
if (session_id) {
    try {
        user = await wrapper.getCurrentSession(session_id)
        Session.set(user)
    } catch (error) {
        console.error('Failed to get current session:', error)
        Session.set(null)
        Astro.cookies.delete('session_id')
    }
} else {
    Session.set(null)
}

let NavbarComponent;
if (!nonav && user?.profile?.is_seller) {
    NavbarComponent = (await import("@components/SellerNavbar.astro")).default;
} else if (!nonav) {
    NavbarComponent = (await import("@components/ClientNavbar.astro")).default;
}

export const prerender = false
---

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <slot name="head" />
</head>
<body>
<div id="site-container" data-session-id={session_id}>
    {NavbarComponent && <NavbarComponent />}
    <slot name="body"/>
</div>

<script>
    import { addNotification, updateNotifications } from "../stores/pages/Notifications";
    import { addChat, updateChats, addMessage } from "../stores/pages/Chats";
    import type { Notification } from "@interfaces/Notifications";
    import type { ChatPreview, ChatMessage } from "@interfaces/Chat";
    import APIWrapper, { RequestAPIFrom } from "../API/Wrapper";
    import geoLocation from "../utils/geoLocation";

    geoLocation.watchPosition();
    const siteContainer = document.getElementById('site-container');
    const session_id = siteContainer ? siteContainer.getAttribute('data-session-id') : null;
    const connection = new WebSocket(`${import.meta.env.PUBLIC_WS_URL}`);
    const API = new APIWrapper(RequestAPIFrom.Client);
    
    let currentUserId = null;

    async function initializeStores() {
        if (session_id) {
            try {
                const notifications = await API.getNotifications(session_id);

                if (notifications) {
                    updateNotifications(notifications);
                }

                const chats = await API.getChats(undefined);
                if (chats) {
                    updateChats(chats);
                }
                
                const userSession = await API.getCurrentSession(session_id, false);
                currentUserId = userSession.id;
            } catch (error) {
                console.error("Failed to initialize stores:", error);
            }
        }
    }

    initializeStores();

    connection.addEventListener("open", () => {
        const identify = {
            opcode: 10,
            d: {
                session_id,
            }
        }

        connection.send(JSON.stringify(identify))
    })

    connection.addEventListener("message", (msg) => {
        const decoded_payload = JSON.parse(msg.data);

        if (decoded_payload.opcode) {
            switch (decoded_payload.opcode) {
                case 11:
                    const notification = decoded_payload.d as Notification;
                    addNotification(notification);
                    break;
                case 12:
                    const messageData = decoded_payload.d;
                    const message: ChatMessage = {
                        id: messageData.id,
                        content: messageData.content,
                        created_at: new Date(messageData.created_at).getTime() / 1000,
                        is_author: currentUserId === messageData.author_id,
                        viewed: false
                    };
                    
                    const chatId = messageData.chat;
                    addMessage(chatId, message);
                    break;
            }
        }
    })
    
    connection.addEventListener("error", (error) => {
        console.error('WebSocket error:', error)
    })
</script>
</body>