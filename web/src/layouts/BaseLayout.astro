---
import "@styles/global.scss";

import ClientNavbar from "@components/ClientNavbar.astro";
import APIWrapper, {RequestAPIFrom} from "../API/Wrapper";
import SellerNavbar from "@components/SellerNavbar.astro";
import Session from "../stores/Session";

interface Props {
    no_nav?: boolean
}

const nonav = Astro.props?.no_nav

const session_cookie = Astro.cookies.get("session_id")
const session_id = session_cookie?.value || null
const wrapper = new APIWrapper(RequestAPIFrom.Server)

let user = Session.get()
if (!user) {
    user = session_id ? await wrapper.getCurrentSession(session_id) : null
    Session.set(user)
} else {
    if (!session_id) {
        Session.set(null)
    } else {
        user = Session.get()
    }
}

export const prerender = false
---

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <slot name="head" />
</head>
<body>
    <div id="site-container">
        {
            !nonav && (user?.profile?.is_seller ? <SellerNavbar /> : <ClientNavbar />)
        }
        <slot name="body"/>
    </div>
</body>